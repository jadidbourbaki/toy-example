{
  "name": "orla-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "types": "json2ts --input src/types/schema.json --output src/types/wire.ts --unreachableDefinitions && prettier --write src/types/wire.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "fmt": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "check": "prettier --check \"src/**/*.{ts,tsx,css}\" && eslint src && tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/themes": "3.3.0",
    "@xyflow/react": "12.11.3",
    "eventsource-parser": "4.1.0",
    "lucide-react": "1.34.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "eslint": "10.9.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "json-schema-to-typescript": "15.0.4",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2"
  }
}
