{
  "id": "customer_support",
  "name": "Customer support",
  "description": "Read a customer message, draft an answer from the policy documents, have a person approve it, and email it. A problem a team has to act on becomes a ticket for that team.",
  "nodes": [
    {
      "id": "c1",
      "name": "input",
      "position": {
        "x": 0,
        "y": 320
      },
      "notes": "",
      "config": {
        "kind": "input",
        "description": "A message from a customer."
      }
    },
    {
      "id": "c2",
      "name": "classify",
      "position": {
        "x": 200,
        "y": 290
      },
      "notes": "",
      "config": {
        "kind": "router",
        "stage": "classify",
        "model": "glm-4.7-flash",
        "question": "Is this a question a policy answers, or a problem a team has to act on?",
        "prompt": "${input}",
        "routes": [
          {
            "label": "policy",
            "description": "A question answered by a policy: refunds, shipping, returns, account access, data, cancellation."
          },
          {
            "label": "team",
            "description": "A problem a team has to act on: a bug, a billing error, an outage, a complaint."
          }
        ]
      }
    },
    {
      "id": "c3",
      "name": "research",
      "position": {
        "x": 520,
        "y": 40
      },
      "notes": "",
      "config": {
        "kind": "react",
        "stage": "research",
        "model": "qwen3-coder-30b",
        "instructions": "Search the policy documents before answering. Return the policy sections that apply, quoted, with their topic tags. Say plainly when no policy covers the question.",
        "prompt": "Find the policy that answers this customer: ${input}",
        "tools": [
          "search_policies"
        ],
        "max_iterations": 4
      }
    },
    {
      "id": "c4",
      "name": "reply",
      "position": {
        "x": 820,
        "y": 40
      },
      "notes": "",
      "config": {
        "kind": "llm",
        "stage": "reply",
        "model": "nemotron-super-120b",
        "instructions": "Write the email a support agent would send. Four sentences at most, warm and direct, and cite the policy in plain words. Open with the answer.",
        "prompt": "Customer message:\n${input}\n\nPolicy findings:\n${research}"
      }
    },
    {
      "id": "c9",
      "name": "approve",
      "position": {
        "x": 1420,
        "y": 40
      },
      "notes": "",
      "config": {
        "kind": "approve",
        "question": "Send this reply to the customer?",
        "max_rounds": 3
      }
    },
    {
      "id": "c5",
      "name": "email",
      "position": {
        "x": 1720,
        "y": 40
      },
      "notes": "",
      "config": {
        "kind": "tool",
        "tool": "send_email",
        "arguments": {
          "to": "the customer",
          "body": "${approve}"
        }
      }
    },
    {
      "id": "c8",
      "name": "judge",
      "position": {
        "x": 1120,
        "y": 40
      },
      "notes": "",
      "config": {
        "kind": "judge",
        "stage": "judge",
        "model": "glm-4.7-flash",
        "criteria": "Answers the customer's question. Cites the policy in plain words. Four sentences at most. Promises nothing the policy findings do not support.",
        "max_rounds": 2
      }
    },
    {
      "id": "c6",
      "name": "route_to_team",
      "position": {
        "x": 520,
        "y": 440
      },
      "notes": "",
      "config": {
        "kind": "react",
        "stage": "triage",
        "model": "glm-4.7-flash",
        "instructions": "Decide which team owns this problem, then open one ticket for them with a one sentence summary. Teams: billing, engineering, shipping, accounts.",
        "prompt": "${input}",
        "tools": [
          "create_ticket"
        ],
        "max_iterations": 3
      }
    },
    {
      "id": "c7",
      "name": "output",
      "position": {
        "x": 2020,
        "y": 320
      },
      "notes": "",
      "config": {
        "kind": "output",
        "description": "What happened for this customer."
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "source": "c1",
      "target": "c2",
      "label": ""
    },
    {
      "id": "e2",
      "source": "c2",
      "target": "c3",
      "label": "policy"
    },
    {
      "id": "e3",
      "source": "c3",
      "target": "c4",
      "label": ""
    },
    {
      "id": "e8",
      "source": "c4",
      "target": "c8",
      "label": ""
    },
    {
      "id": "e4",
      "source": "c8",
      "target": "c9",
      "label": ""
    },
    {
      "id": "e9",
      "source": "c9",
      "target": "c5",
      "label": ""
    },
    {
      "id": "e5",
      "source": "c5",
      "target": "c7",
      "label": ""
    },
    {
      "id": "e6",
      "source": "c2",
      "target": "c6",
      "label": "team"
    },
    {
      "id": "e7",
      "source": "c6",
      "target": "c7",
      "label": ""
    }
  ],
  "sample": [
    "I bought a jacket three weeks ago and it does not fit. Can I get my money back?",
    "Your checkout page has charged my card twice for one order.",
    "How long does express shipping take and what does it cost?"
  ]
}
