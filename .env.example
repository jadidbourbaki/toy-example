AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-west-2

# What a deployed copy calls models with. `just key` writes it, scoped to
# invoking models and expiring in 30 days, so a copy shared by link never
# carries a credential that can do more or last longer than the demo.
DEPLOY_BEDROCK_TOKEN=

# The HTTP Basic password a deployed copy sits behind, under the user name
# "orla". `just deploy` refuses to run without one. A local run never reads
# it, so `just serve` still asks for nothing.
DEPLOY_PASSWORD=

# What everyone sharing that copy may spend on model calls between restarts.
# The password says who gets in. The cap says what they may cost. Defaults
# to 200.
DEPLOY_SPEND_CAP_USD=200

# Where `just budget` mails the account-wide billing alarm, and the monthly
# figure it fires against. The cap above counts only what went through the
# app, so the alarm is what notices anything else.
DEPLOY_ALERT_EMAIL=
DEPLOY_BUDGET_USD=300
